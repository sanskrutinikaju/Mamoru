# Copy this file to .env and fill in values locally.
# Never commit .env.

# Shared secret. Use the SAME value in extension/config.js
# Generate a unique random value for your local demo.
MAMORU_API_TOKEN=dev-only-change-me

# Set this to the exact chrome-extension:// ID shown on chrome://extensions.
# Leave empty to disable browser-origin access until the extension is configured.
MAMORU_EXTENSION_ORIGIN=

# Maximum extracted page characters accepted by POST /analyze
MAMORU_MAX_CONTENT_CHARS=50000

# OpenAI key; used only by the local backend. Never put this in extension/config.js.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
