{
  "version": "2.0",
  "description": "Deterministic text rules for synthetic threat-signal detection.",
  "rules": [
    {
      "id": "credential_request",
      "description": "Requests a password, passcode, credentials, or verification code.",
      "severity": "High",
      "category": "credential_request",
      "pattern": "\\b(?:enter|provide|submit|share|send|confirm|verify)\\s+(?:your\\s+)?(?:(?:account|login|bank(?:ing)?|email|sign[- ]in)\\s+)*(?:password|passcode|credentials|security\\s+code|(?:one[- ]time|verification)\\s+code|login details)\\b"
    },
    {
      "id": "urgency_pressure",
      "description": "Uses urgent deadlines or threatened account consequences.",
      "severity": "Medium",
      "category": "urgency_pressure",
      "pattern": "\\b(?:act\\s+now|immediately|within\\s+\\d+\\s+(?:minutes?|hours?|days?)|(?:account|session)\\s+(?:will\\s+be|is)\\s+(?:suspended|locked|closed|expired)|final\\s+warning|limited[- ]time\\s+offer|ends?\\s+(?:today|soon)|expires?\\s+(?:today|soon|in\\s+\\d+\\s+(?:minutes?|hours?|days?)))\\b"
    },
    {
      "id": "prompt_injection",
      "description": "Contains text that attempts to override instructions or expose hidden prompts.",
      "severity": "High",
      "category": "prompt_injection",
      "pattern": "\\b(?:ignore|disregard|forget|override)\\s+(?:all\\s+)?(?:previous|prior|earlier|above)\\s+(?:system\\s+)?(?:instructions|rules|messages)\\b|\\b(?:reveal|print|show|repeat|output)\\s+(?:the\\s+)?(?:hidden\\s+)?(?:system\\s+prompt|system\\s+instructions)\\b|\\byou\\s+are\\s+now\\s+(?:the\\s+)?(?:system|developer)\\b"
    },
    {
      "id": "deceptive_link_wording",
      "description": "Pairs a link or button instruction with account verification, sign-in, or reward claims.",
      "severity": "Medium",
      "category": "deceptive_link",
      "pattern": "\\b(?:click|open|follow|use)\\s+(?:this|the)\\s+(?:link|button|url)\\s+(?:below\\s+)?(?:to\\s+)?(?:sign\\s*in|log\\s*in|verify\\s+(?:your\\s+)?(?:account|identity|payment)|unlock\\s+(?:your\\s+)?account|claim\\s+(?:your\\s+)?(?:(?:sample|demo)\\s+)?(?:prize|reward)|enter\\s+(?:your\\s+)?(?:password|credentials))\\b"
    }
  ]
}
