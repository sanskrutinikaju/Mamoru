# Copy this file to .env and fill in values locally.
# Never commit .env.

# Shared secret. Use the SAME value in extension/config.js
# Generate a unique random value for your local demo.
MAMORU_API_TOKEN=dev-only-change-me

# Set this to the exact chrome-extension:// ID shown on chrome://extensions.
# Leave empty to disable browser-origin access until the extension is configured.
MAMORU_EXTENSION_ORIGIN=

# Maximum extracted page characters accepted by POST /analyze
MAMORU_MAX_CONTENT_CHARS=50000

# Gemini Developer API key; used only by synthetic evaluation.
# The free tier may use prompts and responses to improve Google's products.
# Never send real page text, personal data, or confidential information to Gemini.
# Verify the Gemini project is on the free tier and has no billing enabled.
GEMINI_API_KEY=
# Required: use an exact, currently available model ID from Google AI Studio.
GEMINI_MODEL=

# Minimum seconds between outbound Gemini HTTP requests.
GEMINI_MIN_SECONDS_BETWEEN_CALLS=12
# Maximum outbound Gemini HTTP attempts in one evaluator process, including retries.
GEMINI_MAX_CALLS_PER_RUN=40
